{
  "name": "@nightpoll/contract",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "compact": "compact compile +0.31.1 src/nightpoll.compact ./src/managed/nightpoll",
    "compact:fast": "compact compile +0.31.1 --skip-zk src/nightpoll.compact ./src/managed/nightpoll",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "rm -rf dist && tsc --project tsconfig.build.json && cp -Rf ./src/managed ./dist/managed && cp ./src/nightpoll.compact ./dist",
    "test": "vitest run",
    "ci": "npm run compact && npm run typecheck && npm run test"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "0.16.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
